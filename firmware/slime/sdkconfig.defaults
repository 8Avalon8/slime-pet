CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y

# We push our own frames; the LVGL adapter is not started.
CONFIG_BSP_CO5300_ENABLE_TE=n

# USB CDC console on the Type-C OTG port (main/usb_link.c)
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# Wi-Fi / lwIP buffers in PSRAM: keep internal RAM for DMA and the renderer
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Internal RAM is the scarce resource (LCD DMA descriptors, task stacks): keep Wi-Fi code in flash
# and send mid-size allocations to PSRAM
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Camera (left slot). GPIO33 is camera D2 and shares the USB Serial/JTAG D- pad: keep USJ off.
# Our USB console/flashing uses the high-speed OTG port (TinyUSB), which is unaffected.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_MOSAICO_MODULE_CAMERA=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y

# hangs reboot (and are recorded) instead of freezing with the speaker buzzing
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=n

# OTA: a new image must confirm itself (after 30 s of running) or the bootloader rolls back
CONFIG_BOOTLOADER_APP_ROLLBACK=y
CONFIG_BOOTLOADER_APP_ROLLBACK_CONFIRM_BY_APP=y

# Wi-Fi/lwIP sized for internal RAM, as run on the device (the LCD DMA needs the headroom)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y

# Wake word: one WakeNet9 model, no command recognition (those models would not fit)
CONFIG_SR_WN_WN9_XIAOLONGXIAOLONG_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# Hand gesture models live in their own flash partitions (see partitions.csv), not inside the
# firmware: the firmware runs from PSRAM, and models embedded in it would take 1.5 MB of it for good
CONFIG_HAND_DETECT_MODEL_IN_FLASH_PARTITION=y
CONFIG_HAND_GESTURE_CLS_MODEL_IN_FLASH_PARTITION=y
